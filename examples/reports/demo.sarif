{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "hetzner-security-skills",
          "version": "0.1.0",
          "rules": [
            {
              "id": "HETZ-BCP-001",
              "shortDescription": {
                "text": "Production stateful asset lacks observed backup coverage"
              },
              "helpUri": "https://docs.hetzner.com/cloud/servers/backups-snapshots/overview/"
            },
            {
              "id": "HETZ-DKR-001",
              "shortDescription": {
                "text": "Privileged container crosses the host isolation boundary"
              },
              "helpUri": "https://docs.docker.com/engine/security/"
            },
            {
              "id": "HETZ-DKR-002",
              "shortDescription": {
                "text": "Container can control the Docker daemon"
              },
              "helpUri": "https://docs.docker.com/engine/security/"
            },
            {
              "id": "HETZ-DKR-003",
              "shortDescription": {
                "text": "Container shares the host PID namespace"
              },
              "helpUri": "https://docs.docker.com/engine/security/"
            },
            {
              "id": "HETZ-DKR-004",
              "shortDescription": {
                "text": "Container shares the host network namespace"
              },
              "helpUri": "https://docs.docker.com/engine/security/"
            },
            {
              "id": "HETZ-IAC-001",
              "shortDescription": {
                "text": "Runtime network access diverges from declared infrastructure"
              },
              "helpUri": "https://developer.hashicorp.com/terraform/tutorials/state/resource-drift"
            },
            {
              "id": "HETZ-NET-001",
              "shortDescription": {
                "text": "SSH reachable from the public internet"
              },
              "helpUri": "https://docs.hetzner.com/cloud/firewalls/overview/"
            },
            {
              "id": "HETZ-NET-002",
              "shortDescription": {
                "text": "Docker daemon reachable from the public internet"
              },
              "helpUri": "https://docs.hetzner.com/cloud/firewalls/overview/"
            },
            {
              "id": "HETZ-NET-003",
              "shortDescription": {
                "text": "PostgreSQL reachable from the public internet"
              },
              "helpUri": "https://docs.hetzner.com/cloud/firewalls/overview/"
            },
            {
              "id": "HETZ-NET-004",
              "shortDescription": {
                "text": "Redis reachable from the public internet"
              },
              "helpUri": "https://docs.hetzner.com/cloud/firewalls/overview/"
            },
            {
              "id": "HETZ-NET-005",
              "shortDescription": {
                "text": "Internet-facing server has no observed firewall control"
              },
              "helpUri": "https://docs.hetzner.com/cloud/firewalls/overview/"
            },
            {
              "id": "HETZ-PG-001",
              "shortDescription": {
                "text": "Broad PostgreSQL trust authentication bypasses credentials"
              },
              "helpUri": "https://www.postgresql.org/docs/current/auth-pg-hba-conf.html"
            },
            {
              "id": "HETZ-PG-002",
              "shortDescription": {
                "text": "Unexpected PostgreSQL roles hold superuser capability"
              },
              "helpUri": "https://www.postgresql.org/docs/current/role-attributes.html"
            },
            {
              "id": "HETZ-RDS-001",
              "shortDescription": {
                "text": "Redis accepts non-local clients without an authentication control"
              },
              "helpUri": "https://redis.io/docs/latest/operate/oss_and_stack/management/security/"
            },
            {
              "id": "HETZ-VULN-001",
              "shortDescription": {
                "text": "Vulnerable component in non-public workload"
              },
              "helpUri": "https://example.invalid/CVE-DEMO-0002"
            },
            {
              "id": "HETZ-XLY-001",
              "shortDescription": {
                "text": "staging workload can reach prod postgres"
              },
              "helpUri": "https://docs.hetzner.com/cloud/networks/overview/"
            }
          ]
        }
