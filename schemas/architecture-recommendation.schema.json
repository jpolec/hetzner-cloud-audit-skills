{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hetzner-cloud-audit-skills:schema:architecture-recommendation:1.0.0",
  "title": "Verified cross-domain architecture recommendation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "rule_id", "title", "provider", "status", "assets", "observation_window",
    "current_state", "metrics", "data_gaps", "candidate_state", "estimated_savings",
    "risk", "confidence", "prerequisites", "evidence", "cross_domain_impacts",
    "verification", "implementation", "discovered_at"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "rule_id": {"type": "string", "pattern": "^[A-Z]+-[A-Z]+-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "provider": {"enum": ["hetzner", "aws", "gcp", "azure", "oci", "multi-cloud"]},
    "status": {"enum": ["confirmed", "needs_validation", "rejected"]},
    "assets": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "observation_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "days"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "days": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "current_state": {"type": "object"},
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "statistic", "value", "unit", "source", "collected_at"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "statistic": {"type": "string", "minLength": 1},
          "value": {"type": "number"},
          "unit": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "collected_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "data_gaps": {"type": "array", "items": {"type": "string"}},
    "candidate_state": {"type": "object"},
    "estimated_savings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monthly", "annual", "currency", "basis", "price_observed_at"],
      "properties": {
        "monthly": {"type": "number", "minimum": 0},
        "annual": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "basis": {"type": "string", "minLength": 1},
        "price_observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "risk": {"enum": ["high", "medium", "low"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "cross_domain_impacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["security", "reliability", "performance"],
      "properties": {
        "security": {"type": "array", "items": {"type": "string"}},
        "reliability": {"type": "array", "items": {"type": "string"}},
        "performance": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "result", "notes"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "result": {"enum": ["confirmed", "needs_validation", "rejected"]},
        "notes": {"type": "string"}
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "validation", "rollback"],
      "properties": {
        "steps": {"type": "array", "items": {"type": "string"}},
        "validation": {"type": "array", "items": {"type": "string"}},
        "rollback": {"type": "array", "items": {"type": "string"}}
      }
    },
    "discovered_at": {"type": "string", "format": "date-time"}
  }
}
