{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hetzner-security/asset.schema.json",
  "title": "Normalized asset",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "name", "properties", "labels", "source"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
