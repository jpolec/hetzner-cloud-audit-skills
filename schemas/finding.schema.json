{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hetzner-security/finding.schema.json",
  "title": "Verified security finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "rule_id", "title", "severity", "confidence", "status", "assets",
    "observation", "expected_state", "actual_state", "evidence", "attack_path",
    "prerequisites", "impact", "verification", "remediation", "references",
    "discovered_at", "metadata"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "rule_id": {"type": "string", "pattern": "^HETZ-[A-Z]+-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "severity": {"enum": ["critical", "high", "medium", "low", "info", null]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"enum": ["confirmed", "needs_validation", "rejected"]},
    "assets": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "observation": {"type": "string", "minLength": 1},
    "expected_state": {"type": "string", "minLength": 1},
    "actual_state": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "evidence.schema.json"}},
    "attack_path": {"type": "array", "items": {"type": "string"}},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "impact": {"type": "string", "minLength": 1},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "result", "evidence", "notes"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "result": {"enum": ["confirmed", "needs_validation", "rejected"]},
        "evidence": {"type": "array", "items": {"$ref": "evidence.schema.json"}},
        "notes": {"type": "string"}
      }
    },
    "remediation": {"type": "string", "minLength": 1},
    "references": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "discovered_at": {"type": "string", "format": "date-time"},
    "metadata": {"type": "object"}
  }
}
